# Node environment: development | production | test
NODE_ENV=development

# Supabase PostgreSQL connection string
DATABASE_URL=

# Backend HTTP port
APPLICATION_PORT=3000

# Project name (used in logs, Swagger title, etc.)
PROJECT_NAME=snaptospec

# Claude API key (Anthropic)
ANTHROPIC_API_KEY=

# Supabase project URL (used by SupabaseStorageService)
SUPABASE_URL=

# Supabase service role key (server-side only — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed CORS origins
ALLOWED_CORS_ORIGIN=http://localhost:3001

# Public base URL of the frontend (used in links sent from backend)
FRONTEND_BASE_URL=http://localhost:3001

# Backend API URL consumed by the frontend (Next.js public env var).
# Local dev: http://localhost:3000
# Production (Vercel): set to your Railway backend URL, e.g. https://your-app.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3000
