{
  "name": "snaptospec",
  "version": "0.1.0",
  "private": true,
  "description": "Convert design screenshots into spec overlay images for accurate UI development with Claude.",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "start:dev": "lerna run start:dev --parallel",
    "build": "lerna run build",
    "test": "lerna run test",
    "lint": "eslint . && cspell \"**/*.{ts,tsx,md}\"",
    "prisma:generate": "lerna run prisma:generate --scope=@snaptospec/prisma",
    "prisma:migrate:dev": "lerna run prisma:migrate:dev --scope=@snaptospec/prisma",
    "prisma:migrate:prod": "lerna run prisma:migrate:prod --scope=@snaptospec/prisma"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.16.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cspell": "^8.17.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.13.0",
    "lerna": "^8.1.9",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
